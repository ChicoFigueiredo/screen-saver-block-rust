[Desktop Entry]
Type=Application
Version=1.0
Name=Block Screen Saver
Comment=Bloqueia o protetor de tela e o encerramento de sessão
Exec=block-screen-saver --screen-saver
Icon=/usr/local/share/pixmaps/block-screen-saver.ico
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=block-screen-saver
Keywords=screen;saver;session;idle;lock;
